<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <Company>ivLis Studio</Company>
    <Product>Pickverter</Product>
    <Copyright>© 2026 ivLis Studio · MIT License</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PickverterRelease Condition="'$(PickverterRelease)' == ''">false</PickverterRelease>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);WPF0001;CA1416;CS1998;NU1603</NoWarn>
  </PropertyGroup>
</Project>
